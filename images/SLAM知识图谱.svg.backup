ng SC','Microsoft JhengHei',sans-serif" font-weight="400" font-style="normal"><text id="SvgjsText6428" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" fill="#141414" text-decoration="none" text-anchor="middle" font-size="14" font-weight="400" font-style="normal" transform="translate(116.5 0)" style="user-select: none; cursor: default;"><tspan id="SvgjsTspan12073" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-size="14" font-weight="400" font-style="normal" text-decoration="none" dy="14" x="0" fill="#141414" text-anchor="middle" style="white-space: pre;">‎三维度量地图是许多小方块（Voxel）</tspan></text></g><g id="SvgjsG6430" data="markers-group" class="MARKERS"></g></g></g></g></g></g><g id="SvgjsG6448" data-name="branch" class="branch" transform="translate(923.5 1194.140625)"><g id="SvgjsG6438" data-name="topic" class="topic"><g id="SvgjsG6439" data-name="topic-shape-group"><path id="SvgjsPath6440" data-name="topic-shape-fill" opacity="0" d="M -117 -24L 117 -24Q 125 -24  125 -16L 125 16Q 125 24  117 24L -117 24Q -125 24  -125 16L -125 -16Q -125 -24  -117 -24"></path><path id="SvgjsPath6441" data-name="topic-shape" fill="none" stroke-width="0" d="M -117 -24L 117 -24Q 125 -24  125 -16L 125 16Q 125 24  117 24L -117 24Q -125 24  -125 16L -125 -16Q -125 -24  -117 -24"></path><g id="SvgjsG6442" data-name="topic-content" transform="translate(-119 -18)"><g id="SvgjsG6443" data-name="inner-element-group"><g id="SvgjsG6450" data-name="topic-title-text-group" fill="#141414" text-decoration="none" text-anchor="middle" font-size="14" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-weight="400" font-style="normal"><text id="SvgjsText6449" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" fill="#141414" text-decoration="none" text-anchor="middle" font-size="14" font-weight="400" font-style="normal" transform="translate(119 0)" style="user-select: none; cursor: default;"><tspan id="SvgjsTspan12074" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-size="14" font-weight="400" font-style="normal" text-decoration="none" dy="14" x="0" fill="#141414" text-anchor="middle" style="white-space: pre;">‎一般地含有占据、空闲、未知三种状态</tspan><tspan id="SvgjsTspan12075" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-size="14" font-weight="400" font-style="normal" text-decoration="none" dy="18" x="0" fill="#141414" text-anchor="middle" style="white-space: pre;">‎以表达该格内是否有物体</tspan></text></g><g id="SvgjsG6451" data="markers-group" class="MARKERS"></g></g></g></g></g></g><g id="SvgjsG6479" data-name="branch" class="branch" transform="translate(474.5 1278.140625)"><rect id="SvgjsRect10696" width="52" height="30" data-name="collapse-extend-hover-area" opacity="0" x="20" y="-15"></rect><g id="SvgjsG6469" data-name="topic" class="topic"><g id="SvgjsG6470" data-name="topic-shape-group"><path id="SvgjsPath6471" data-name="topic-shape-fill" opacity="0" d="M -12 -15L 12 -15Q 20 -15  20 -7L 20 7Q 20 15  12 15L -12 15Q -20 15  -20 7L -20 -7Q -20 -15  -12 -15"></path><path id="SvgjsPath6472" data-name="topic-shape" fill="none" stroke-width="0" d="M -12 -15L 12 -15Q 20 -15  20 -7L 20 7Q 20 15  12 15L -12 15Q -20 15  -20 7L -20 -7Q -20 -15  -12 -15"></path><g id="SvgjsG6473" data-name="topic-content" transform="translate(-14 -9)"><g id="SvgjsG6474" data-name="inner-element-group"><g id="SvgjsG6523" data-name="topic-title-text-group" fill="#141414" text-decoration="none" text-anchor="middle" font-size="14" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-weight="400" font-style="normal"><text id="SvgjsText6522" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" fill="#141414" text-decoration="none" text-anchor="middle" font-size="14" font-weight="400" font-style="normal" transform="translate(14 0)" style="user-select: none; cursor: default;"><tspan id="SvgjsTspan12081" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-size="14" font-weight="400" font-style="normal" text-decoration="none" dy="14" x="0" fill="#141414" text-anchor="middle" style="white-space: pre;">‎缺点</tspan></text></g><g id="SvgjsG6524" data="markers-group" class="MARKERS"></g></g></g></g></g></g><g id="SvgjsG6490" data-name="branch" class="branch" transform="translate(699.5 1250.140625)"><g id="SvgjsG6480" data-name="topic" class="topic"><g id="SvgjsG6481" data-name="topic-shape-group"><path id="SvgjsPath6482" data-name="topic-shape-fill" opacity="0" d="M -145 -24L 145 -24Q 153 -24  153 -16L 153 16Q 153 24  145 24L -145 24Q -153 24  -153 16L -153 -16Q -153 -24  -145 -24"></path><path id="SvgjsPath6483" data-name="topic-shape" fill="none" stroke-width="0" d="M -145 -24L 145 -24Q 153 -24  153 -16L 153 16Q 153 24  145 24L -145 24Q -153 24  -153 16L -153 -16Q -153 -24  -145 -24"></path><g id="SvgjsG6484" data-name="topic-content" transform="translate(-147 -18)"><g id="SvgjsG6485" data-name="inner-element-group"><g id="SvgjsG6492" data-name="topic-title-text-group" fill="#141414" text-decoration="none" text-anchor="middle" font-size="14" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-weight="400" font-style="normal"><text id="SvgjsText6491" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" fill="#141414" text-decoration="none" text-anchor="middle" font-size="14" font-weight="400" font-style="normal" transform="translate(147 0)" style="user-select: none; cursor: default;"><tspan id="SvgjsTspan12077" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-size="14" font-weight="400" font-style="normal" text-decoration="none" dy="14" x="0" fill="#141414" text-anchor="middle" style="white-space: pre;">‎需存储每一个小格子的状态，耗费大量的存储空</tspan><tspan id="SvgjsTspan12078" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-size="14" font-weight="400" font-style="normal" text-decoration="none" dy="18" x="0" fill="#141414" text-anchor="middle" style="white-space: pre;">‎间，而多数情况下地图的许多细节部分是无用的</tspan></text></g><g id="SvgjsG6493" data="markers-group" class="MARKERS"></g></g></g></g></g></g><g id="SvgjsG6511" data-name="branch" class="branch" transform="translate(685.5 1306.140625)"><g id="SvgjsG6501" data-name="topic" class="topic"><g id="SvgjsG6502" data-name="topic-shape-group"><path id="SvgjsPath6503" data-name="topic-shape-fill" opacity="0" d="M -131 -24L 131 -24Q 139 -24  139 -16L 139 16Q 139 24  131 24L -131 24Q -139 24  -139 16L -139 -16Q -139 -24  -131 -24"></path><path id="SvgjsPath6504" data-name="topic-shape" fill="none" stroke-width="0" d="M -131 -24L 131 -24Q 139 -24  139 -16L 139 16Q 139 24  131 24L -131 24Q -139 24  -139 16L -139 -16Q -139 -24  -131 -24"></path><g id="SvgjsG6505" data-name="topic-content" transform="translate(-133 -18)"><g id="SvgjsG6506" data-name="inner-element-group"><g id="SvgjsG6513" data-name="topic-title-text-group" fill="#141414" text-decoration="none" text-anchor="middle" font-size="14" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-weight="400" font-style="normal"><text id="SvgjsText6512" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" fill="#141414" text-decoration="none" text-anchor="middle" font-size="14" font-weight="400" font-style="normal" transform="translate(133 0)" style="user-select: none; cursor: default;"><tspan id="SvgjsTspan12079" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-size="14" font-weight="400" font-style="normal" text-decoration="none" dy="14" x="0" fill="#141414" text-anchor="middle" style="white-space: pre;">‎大规模度量地图存在一致性问题</tspan><tspan id="SvgjsTspan12080" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-size="14" font-weight="400" font-style="normal" text-decoration="none" dy="18" x="0" fill="#141414" text-anchor="middle" style="white-space: pre;">‎微小的转向误差，可能会导致地图重叠失效</tspan></text></g><g id="SvgjsG6514" data="markers-group" class="MARKERS"></g></g></g></g></g></g><g id="SvgjsG6552" data-name="branch" class="branch" transform="translate(368.5 1385.640625)"><rect id="SvgjsRect11305" width="52" height="30" data-name="collapse-extend-hover-area" opacity="0" x="34" y="-15"></rect><g id="SvgjsG6542" data-name="topic" class="topic"><g id="SvgjsG6543" data-name="topic-shape-group"><path id="SvgjsPath6544" data-name="topic-shape-fill" opacity="0" d="M -26 -15L 26 -15Q 34 -15  34 -7L 34 7Q 34 15  26 15L -26 15Q -34 15  -34 7L -34 -7Q -34 -15  -26 -15"></path><path id="SvgjsPath6545" data-name="topic-shape" fill="none" stroke-width="0" d="M -26 -15L 26 -15Q 34 -15  34 -7L 34 7Q 34 15  26 15L -26 15Q -34 15  -34 7L -34 -7Q -34 -15  -26 -15"></path><g id="SvgjsG6546" data-name="topic-content" transform="translate(-28 -9)"><g id="SvgjsG6547" data-name="inner-element-group"><g id="SvgjsG6617" data-name="topic-title-text-group" fill="#141414" text-decoration="none" text-anchor="middle" font-size="14" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-weight="400" font-style="normal"><text id="SvgjsText6616" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" fill="#141414" text-decoration="none" text-anchor="middle" font-size="14" font-weight="400" font-style="normal" transform="translate(28 0)" style="user-select: none; cursor: default;"><tspan id="SvgjsTspan12088" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-size="14" font-weight="400" font-style="normal" text-decoration="none" dy="14" x="0" fill="#141414" text-anchor="middle" style="white-space: pre;">‎拓扑地图</tspan></text></g><g id="SvgjsG6618" data="markers-group" class="MARKERS"></g></g></g></g></g></g><g id="SvgjsG6563" data-name="branch" class="branch" transform="translate(607.5 1362.140625)"><rect id="SvgjsRect10709" width="52" height="48" data-name="collapse-extend-hover-area" opacity="0" x="153" y="-24"></rect><g id="SvgjsG6553" data-name="topic" class="topic"><g id="SvgjsG6554" data-name="topic-shape-group"><path id="SvgjsPath6555" data-name="topic-shape-fill" opacity="0" d="M -145 -24L 145 -24Q 153 -24  153 -16L 153 16Q 153 24  145 24L -145 24Q -153 24  -153 16L -153 -16Q -153 -24  -145 -24"></path><path id="SvgjsPath6556" data-name="topic-shape" fill="none" stroke-width="0" d="M -145 -24L 145 -24Q 153 -24  153 -16L 153 16Q 153 24  145 24L -145 24Q -153 24  -153 16L -153 -16Q -153 -24  -145 -24"></path><g id="SvgjsG6557" data-name="topic-content" transform="translate(-147 -18)"><g id="SvgjsG6558" data-name="inner-element-group"><g id="SvgjsG6586" data-name="topic-title-text-group" fill="#141414" text-decoration="none" text-anchor="middle" font-size="14" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-weight="400" font-style="normal"><text id="SvgjsText6585" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" fill="#141414" text-decoration="none" text-anchor="middle" font-size="14" font-weight="400" font-style="normal" transform="translate(147 0)" style="user-select: none; cursor: default;"><tspan id="SvgjsTspan12085" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-size="14" font-weight="400" font-style="normal" text-decoration="none" dy="14" x="0" fill="#141414" text-anchor="middle" style="white-space: pre;">‎强调地图元素之间的关系。拓扑地图由节点和边</tspan><tspan id="SvgjsTspan12086" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-size="14" font-weight="400" font-style="normal" text-decoration="none" dy="18" x="0" fill="#141414" text-anchor="middle" style="white-space: pre;">‎组成，只考虑节点间的连通性</tspan></text></g><g id="SvgjsG6587" data="markers-group" class="MARKERS"></g></g></g></g></g></g><g id="SvgjsG6574" data-name="branch" class="branch" transform="translate(965.5 1362.140625)"><g id="SvgjsG6564" data-name="topic" class="topic"><g id="SvgjsG6565" data-name="topic-shape-group"><path id="SvgjsPath6566" data-name="topic-shape-fill" opacity="0" d="M -145 -24L 145 -24Q 153 -24  153 -16L 153 16Q 153 24  145 24L -145 24Q -153 24  -153 16L -153 -16Q -153 -24  -145 -24"></path><path id="SvgjsPath6567" data-name="topic-shape" fill="none" stroke-width="0" d="M -145 -24L 145 -24Q 153 -24  153 -16L 153 16Q 153 24  145 24L -145 24Q -153 24  -153 16L -153 -16Q -153 -24  -145 -24"></path><g id="SvgjsG6568" data-name="topic-content" transform="translate(-147 -18)"><g id="SvgjsG6569" data-name="inner-element-group"><g id="SvgjsG6576" data-name="topic-title-text-group" fill="#141414" text-decoration="none" text-anchor="middle" font-size="14" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-weight="400" font-style="normal"><text id="SvgjsText6575" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" fill="#141414" text-decoration="none" text-anchor="middle" font-size="14" font-weight="400" font-style="normal" transform="translate(147 0)" style="user-select: none; cursor: default;"><tspan id="SvgjsTspan12083" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-size="14" font-weight="400" font-style="normal" text-decoration="none" dy="14" x="0" fill="#141414" text-anchor="middle" style="white-space: pre;">‎放松了地图对精确位置的需要，去掉地图的细节</tspan><tspan id="SvgjsTspan12084" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-size="14" font-weight="400" font-style="normal" text-decoration="none" dy="18" x="0" fill="#141414" text-anchor="middle" style="white-space: pre;">‎问题，是一种更为紧凑的表达方式</tspan></text></g><g id="SvgjsG6577" data="markers-group" class="MARKERS"></g></g></g></g></g></g><g id="SvgjsG6605" data-name="branch" class="branch" transform="translate(579.5 1409.140625)"><g id="SvgjsG6595" data-name="topic" class="topic"><g id="SvgjsG6596" data-name="topic-shape-group"><path id="SvgjsPath6597" data-name="topic-shape-fill" opacity="0" d="M -117 -15L 117 -15Q 125 -15  125 -7L 125 7Q 125 15  117 15L -117 15Q -125 15  -125 7L -125 -7Q -125 -15  -117 -15"></path><path id="SvgjsPath6598" data-name="topic-shape" fill="none" stroke-width="0" d="M -117 -15L 117 -15Q 125 -15  125 -7L 125 7Q 125 15  117 15L -117 15Q -125 15  -125 7L -125 -7Q -125 -15  -117 -15"></path><g id="SvgjsG6599" data-name="topic-content" transform="translate(-119 -9)"><g id="SvgjsG6600" data-name="inner-element-group"><g id="SvgjsG6607" data-name="topic-title-text-group" fill="#141414" text-decoration="none" text-anchor="middle" font-size="14" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-weight="400" font-style="normal"><text id="SvgjsText6606" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" fill="#141414" text-decoration="none" text-anchor="middle" font-size="14" font-weight="400" font-style="normal" transform="translate(119 0)" style="user-select: none; cursor: default;"><tspan id="SvgjsTspan12087" font-family="'NeverMind','NeverMind','Microsoft YaHei','PingFang SC','Microsoft JhengHei',sans-serif" font-size="14" font-weight="400" font